{
  "name": "fork-recheck",
  "version": "0.1.0",
  "description": "Read-only GitHub fork PR triage and local patch verification",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "fork-recheck": "dist/cli.js"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node src/cli.ts replay verl",
    "eval": "node src/cli.ts eval",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "docs"
  ]
}
